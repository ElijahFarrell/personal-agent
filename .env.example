# ─── LLM (Vercel AI Gateway — replaces all provider keys) ───────────────────
# Get your key at: vercel.com/dashboard → AI Gateway
# Also used for Custom Reporting API (GET /v1/report) — Pro/Enterprise
AI_GATEWAY_API_KEY=

# ─── Braintrust (Vercel Marketplace + optional SDK logger) ───────────────────
# From Vercel integration or braintrust.dev — enables initLogger in instrumentation.ts
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=

# Optional override for OpenTelemetry service name (default: ai-os)
# OTEL_SERVICE_NAME=

# ─── Database (Convex) ───────────────────────────────────────────────────────
# Run `npx convex dev` to create a project and get this value
NEXT_PUBLIC_CONVEX_URL=

# ─── Mastra Storage (workflow suspend/resume) ─────────────────────────────────
# When NEXT_PUBLIC_CONVEX_URL is set, Convex is used (no extra DB). Otherwise:
# - Vercel: :memory: (no persistence) or Turso: MASTRA_STORAGE_URL + TURSO_AUTH_TOKEN
# - Local: file:./mastra.db

# ─── Authentication (Clerk) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Marketing / domains (optional) ───────────────────────────────────────────
# Canonical marketing site — used for metadata, sitemap, JSON-LD
# NEXT_PUBLIC_SITE_URL=https://example.com
# Product app subdomain — sign-in/up links and redirects from marketing domain
# NEXT_PUBLIC_APP_PLATFORM_URL=https://aios.example.com
# Cal.com / booking link — Navbar, Hero, audit confirmation (default: https://cal.com/shilohai/30min)
# NEXT_PUBLIC_BOOK_CALL_URL=

# ─── Resend (email) ──────────────────────────────────────────────────────────
# resend.com — audit report emails + website lead notifications
RESEND_API_KEY=
# Optional: verified sender (default: onboarding@resend.dev in dev)
# RESEND_FROM_EMAIL=audit@example.com
# Optional: admin notification address for new website leads (default: you@example.com)
# LEAD_NOTIFY_EMAIL=you@example.com

# ─── Memory (Mem0) ───────────────────────────────────────────────────────────
# Hosted platform (mem0.ai) — leave blank to use OSS self-hosted
MEM0_API_KEY=

# ─── Composio (OAuth integrations: Gmail, Calendar, Slack, HubSpot, etc.) ─────
# Get your key at: platform.composio.dev → Settings
COMPOSIO_API_KEY=
# Optional: pin toolkit versions for stable manual tool execution (slug lowercase after prefix)
# Example: COMPOSIO_TOOLKIT_VERSION_GMAIL=20250909_00
# If unset, server-side executes use Composio's latest with an explicit skip flag (see executeComposioTool).

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Bot username without @ (e.g. MyBot for t.me/MyBot)
TELEGRAM_BOT_USERNAME=
# Legacy: single owner ID for cron/morning brief (optional with self-service linking)
TELEGRAM_OWNER_ID=

# ─── Vector Store (Qdrant) ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Web Search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=

# ─── LinkedIn ────────────────────────────────────────────────────────────────
# linkedapi.io for production-safe LinkedIn automation (optional, DM sending only)
LINKEDAPI_KEY=

# ─── Unipile (LinkedIn + WhatsApp) ──────────────────────────────────────────
# DSN and access token from Unipile dashboard
UNIPILE_DSN=
UNIPILE_API_KEY=
# Optional: verify inbound webhooks from Unipile
UNIPILE_WEBHOOK_SECRET=

# ─── Apify (LinkedIn enrichment + Workspace YouTube transcripts) ────────────
# Used for LinkedIn profile and posts scraping. Get your token at:
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Optional: override default Actor for YouTube → transcript (default: streamers/youtube-transcript-scraper)
# APIFY_YOUTUBE_TRANSCRIPT_ACTOR_ID=

# ─── Meta / Instagram ────────────────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=

# ─── Scheduling (Inngest + Vercel Cron) ─────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Required for Vercel Cron to call /api/cron/execute (and /api/cron/morning).
# Set in Vercel project env; Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# ─── Voice (OpenAI Whisper STT + TTS) ────────────────────────────────────────
# Used by @mastra/voice-openai for speech-to-text and text-to-speech
OPENAI_API_KEY=

# ─── Retell AI (embedded dashboard web calls + server web-call API) ─────────
# retellai.com — create API key in dashboard; also set the same agent id in the UI
RETELL_API_KEY=
NEXT_PUBLIC_RETELL_WEB_AGENT_ID=
# Optional: verify incoming webhooks from Retell / generic SMS provider
# RETELL_WEBHOOK_SECRET=
# SMS_WEBHOOK_SECRET=
# Shared secret for Next.js → Convex mutations from webhook routes (set in Vercel + Convex env)
# INTERNAL_WEBHOOK_SECRET=

# ─── Platform builder (full catalog bypass for niche gating) ────────────────
# Comma-separated Clerk user IDs and/or org IDs — server-only, never exposed to client
PLATFORM_FULL_ACCESS_USER_IDS=
PLATFORM_FULL_ACCESS_ORG_IDS=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
