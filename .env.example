# ─── LLM (Vercel AI Gateway — replaces all provider keys) ───────────────────
# Get your key at: vercel.com/dashboard → AI Gateway
AI_GATEWAY_API_KEY=

# ─── Database (Convex) ───────────────────────────────────────────────────────
# Run `npx convex dev` to create a project and get this value
NEXT_PUBLIC_CONVEX_URL=

# ─── Authentication (Clerk) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Memory (Mem0) ───────────────────────────────────────────────────────────
# Hosted platform (mem0.ai) — leave blank to use OSS self-hosted
MEM0_API_KEY=

# ─── OAuth Connections (Nango) ───────────────────────────────────────────────
NANGO_SECRET_KEY=
NANGO_WEBHOOK_SECRET=
NEXT_PUBLIC_NANGO_PUBLIC_KEY=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your personal Telegram user ID (find via @userinfobot)
TELEGRAM_OWNER_ID=

# ─── Vector Store (Qdrant) ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Web Search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=

# ─── LinkedIn ────────────────────────────────────────────────────────────────
# linkedapi.io for production-safe LinkedIn automation
LINKEDAPI_KEY=

# ─── Meta / Instagram ────────────────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=

# ─── Scheduling (Inngest) ────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Voice Transcription (WisprFlow) ─────────────────────────────────────────
# Get API access at: platform.wisprflow.ai
WISPR_FLOW_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
